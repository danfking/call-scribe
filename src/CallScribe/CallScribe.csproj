<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0-windows is the headline build (live capture) and the only target by default, so the
         local inner loop (dotnet run/build) is unambiguous. The portable net10.0 target (everything
         downstream of a WAV, no Windows-only audio) is opted into with -p:TargetFrameworks=net10.0:
         the Docker image builds it, and CI verifies it to catch platform leaks. -->
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <RootNamespace>CallScribe</RootNamespace>
    <AssemblyName>call-scribe</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Expose internal pure helpers (RMS/amplitude/annotation gating) to the test project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CallScribe.Tests" />
  </ItemGroup>

  <!-- Windows-only audio: WASAPI loopback/mic capture and the COM AEC DSP. Excluded from the
       portable net10.0 compile so the CA1416 platform analyzer stays clean under
       TreatWarningsAsErrors; the portable build uses UnsupportedCaptureBackend instead. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="Audio\WindowsCaptureBackend.cs" />
    <Compile Remove="Audio\VoiceCaptureAecSource.cs" />
    <Compile Remove="Audio\VoiceCaptureAecInterop.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.3" />
    <PackageReference Include="Pgvector" Version="0.3.1" />
    <PackageReference Include="Spectre.Console" Version="0.51.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <!-- CUDA runtime only in the dedicated GPU publish profile: it balloons the artifact
       and requires the user's CUDA Toolkit. CPU is the headline build. -->
  <ItemGroup Condition="'$(CallScribeCuda)' == 'true'">
    <PackageReference Include="Whisper.net.Runtime.Cuda.Windows" Version="1.9.1" />
  </ItemGroup>

</Project>
